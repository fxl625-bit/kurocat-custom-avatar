diff --git a/src-tauri/src/avatar.rs b/src-tauri/src/avatar.rs
new file mode 100644
index 0000000000000000000000000000000000000000..63d884301eb83b6d88c04db81c5a651cd2dd0fc2
--- /dev/null
+++ b/src-tauri/src/avatar.rs
@@ -0,0 +1,182 @@
+use serde::{Deserialize, Serialize};
+#[cfg(windows)]
+use std::{io::Write, os::windows::process::CommandExt, path::PathBuf, process::{Command, Stdio}};
+use tauri::{AppHandle, Emitter, Manager, WebviewUrl, WebviewWindowBuilder};
+
+const IMAGE_PREFIX: &str = "data:image/webp;base64,";
+const MAX_IMAGE_LENGTH: usize = 3_000_000;
+
+fn valid_image(image: &str) -> bool {
+    image.len() <= MAX_IMAGE_LENGTH && image.starts_with(IMAGE_PREFIX)
+}
+
+#[derive(Deserialize, Serialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum Character {
+    PhotographedPortrait,
+    Luffy,
+    Nami,
+    Naruto,
+}
+impl Character {
+    fn rig_name(&self) -> &'static str {
+        match self {
+            Self::PhotographedPortrait => "portrait-motion.json",
+            Self::Luffy => "luffy-rig.json",
+            Self::Nami => "nami-rig.json",
+            Self::Naruto => "naruto-rig.json",
+        }
+    }
+}
+#[tauri::command]
+pub fn available_anime() -> Vec<Character> {
+    let dir = crate::config::app_data_dir();
+    [Character::Luffy, Character::Nami, Character::Naruto].into_iter()
+        .filter(|character| dir.join(character.rig_name()).is_file()).collect()
+}
+
+#[derive(Default, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Avatar {
+    image: Option<String>,
+    enabled: bool,
+    #[serde(default)]
+    character: Option<Character>,
+}
+
+#[tauri::command]
+pub fn get_avatar() -> Result<Avatar, String> {
+    let path = crate::config::app_data_dir().join("avatar.json");
+    match std::fs::read(path) {
+        Ok(data) => serde_json::from_slice(&data).map_err(|err| err.to_string()),
+        Err(err) if err.kind() == std::io::ErrorKind::NotFound => Ok(Avatar::default()),
+        Err(err) => Err(err.to_string()),
+    }
+}
+
+#[tauri::command]
+pub fn get_portrait_rig(character: Option<Character>) -> Result<Option<serde_json::Value>, String> {
+    let path = crate::config::app_data_dir().join(character.unwrap_or(Character::PhotographedPortrait).rig_name());
+    match std::fs::read(path) {
+        Ok(data) if data.len() <= 2_000_000 => serde_json::from_slice(&data)
+            .map(Some)
+            .map_err(|err| err.to_string()),
+        Ok(_) => Err("Portrait data is too large".into()),
+        Err(err) if err.kind() == std::io::ErrorKind::NotFound => Ok(None),
+        Err(err) => Err(err.to_string()),
+    }
+}
+
+#[tauri::command]
+pub fn has_portrait_rig() -> bool {
+    crate::config::app_data_dir().join("portrait-motion.json").is_file()
+}
+
+#[tauri::command]
+pub fn save_avatar(app: AppHandle, avatar: Avatar) -> Result<(), String> {
+    if avatar.enabled && avatar.character.is_some() {
+        return Err("Choose one active appearance".into());
+    }
+    if let Some(character) = &avatar.character {
+        if !crate::config::app_data_dir().join(character.rig_name()).is_file() {
+            return Err("找不到角色动作素材。".into());
+        }
+    }
+    if let Some(image) = &avatar.image {
+        if !valid_image(image) {
+            return Err("Invalid image data".into());
+        }
+    } else if avatar.enabled {
+        return Err("Select an image first".into());
+    }
+
+    let path = crate::config::app_data_dir().join("avatar.json");
+    crate::config::write_json_atomic(path, &avatar).map_err(|err| err.to_string())?;
+    let _ = app.emit_to("main", "kuro-avatar-changed", ());
+    Ok(())
+}
+
+#[tauri::command]
+pub async fn cutout_avatar(image: String) -> Result<String, String> {
+    if !valid_image(&image) {
+        return Err("图片数据无效，请重新选择。".into());
+    }
+
+    tauri::async_runtime::spawn_blocking(move || run_cutout(image))
+        .await
+        .map_err(|_| String::from("抠图任务中断，请重试。"))?
+}
+
+#[cfg(windows)]
+fn run_cutout(image: String) -> Result<String, String> {
+    const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+    let runtime_error = "本机抠图组件不可用。";
+    let exe = std::env::current_exe().map_err(|_| runtime_error.to_string())?;
+    let app_dir = exe.parent().ok_or(runtime_error)?;
+    let python = std::env::var_os("LOCALAPPDATA")
+        .map(PathBuf::from)
+        .ok_or(runtime_error)?
+        .join("Programs").join("Python").join("Python310").join("python.exe");
+    let models = app_dir.join("models");
+    if !python.is_file() || !models.join("isnet-general-use.onnx").is_file() {
+        return Err(runtime_error.into());
+    }
+    let temporary_dir = crate::config::app_data_dir().join("tmp");
+    std::fs::create_dir_all(&temporary_dir).map_err(|_| runtime_error.to_string())?;
+
+    let mut child = Command::new(python)
+        .args(["-I", "-B", "-c", include_str!("avatar_cutout.py")])
+        .env("U2NET_HOME", models)
+        .env("OMP_NUM_THREADS", "4")
+        .env("TEMP", &temporary_dir)
+        .env("TMP", &temporary_dir)
+        .creation_flags(CREATE_NO_WINDOW)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .map_err(|_| runtime_error.to_string())?;
+    let write_result = child.stdin.take()
+        .ok_or(runtime_error)?
+        .write_all(image.as_bytes());
+    let output = child.wait_with_output().map_err(|_| runtime_error.to_string())?;
+    if !output.status.success() {
+        let error = String::from_utf8_lossy(&output.stderr);
+        if error.contains("No distinct foreground and background") {
+            return Err("未能分出主体和背景，请换一张轮廓更清楚的图片。".into());
+        }
+        eprintln!("Local avatar cutout failed: {error}");
+        return Err("抠图失败，请重试或选择一张透明 PNG。".into());
+    }
+    write_result.map_err(|_| runtime_error.to_string())?;
+    let image = String::from_utf8(output.stdout).map_err(|_| runtime_error.to_string())?;
+    if valid_image(&image) {
+        Ok(image)
+    } else {
+        Err("抠图结果无效，请换一张图。".into())
+    }
+}
+
+#[cfg(not(windows))]
+fn run_cutout(_image: String) -> Result<String, String> {
+    Err("此版本的自动抠图需要 Windows。".into())
+}
+
+#[tauri::command]
+pub async fn open_avatar_window(app: AppHandle) -> Result<(), String> {
+    if let Some(window) = app.get_webview_window("avatar") {
+        window.show().map_err(|err| err.to_string())?;
+        return window.set_focus().map_err(|err| err.to_string());
+    }
+
+    WebviewWindowBuilder::new(&app, "avatar", WebviewUrl::App("avatar.html".into()))
+        .title("KuroCat · 自定义形象")
+        .inner_size(492.0, 656.0)
+        .min_inner_size(360.0, 475.0)
+        .center()
+        .always_on_top(true)
+        .additional_browser_args("--autoplay-policy=no-user-gesture-required")
+        .build()
+        .map(|_| ())
+        .map_err(|err| err.to_string())
+}
diff --git a/src-tauri/src/avatar_cutout.py b/src-tauri/src/avatar_cutout.py
new file mode 100644
index 0000000000000000000000000000000000000000..4a93252c3e29929d09fd16fe45d81328eadb184f
--- /dev/null
+++ b/src-tauri/src/avatar_cutout.py
@@ -0,0 +1,52 @@
+import base64
+from io import BytesIO
+import os
+import sys
+
+from PIL import Image, ImageChops
+from rembg import new_session, remove
+
+MODEL = "isnet-general-use"
+PREFIX = "data:image/webp;base64,"
+
+
+def cutout(source):
+    rgb = source.convert("RGB")
+    session = new_session(MODEL, providers=["CPUExecutionProvider"])
+    mask = remove(rgb, session=session, only_mask=True).convert("L")
+    mask = mask.point(
+        lambda value: 0 if value <= 12 else 255 if value >= 244 else round((value - 12) * 255 / 232)
+    )
+    if "A" in source.getbands():
+        mask = ImageChops.multiply(mask, source.getchannel("A"))
+    histogram = mask.histogram()
+    pixels = source.width * source.height
+    if sum(histogram[96:]) < pixels * 0.015 or sum(histogram[:96]) < pixels * 0.015:
+        raise ValueError("No distinct foreground and background")
+    clean = Image.new("RGB", source.size)
+    clean.paste(rgb, (0, 0), mask.point(lambda value: 255 if value else 0))
+    clean.putalpha(mask)
+    return clean
+
+
+def main():
+    model_dir = os.environ["U2NET_HOME"]
+    if not os.path.isfile(os.path.join(model_dir, MODEL + ".onnx")):
+        raise FileNotFoundError("Local cutout model is missing")
+    payload = sys.stdin.buffer.read(3_000_001)
+    prefix = PREFIX.encode("ascii")
+    if len(payload) > 3_000_000 or not payload.startswith(prefix):
+        raise ValueError("Invalid avatar data")
+    raw = base64.b64decode(payload[len(prefix):], validate=True)
+    with Image.open(BytesIO(raw)) as source:
+        if max(source.size) > 768:
+            raise ValueError("Unexpected image size")
+        result = cutout(source.convert("RGBA"))
+    result = result.crop(result.getchannel("A").getbbox())
+    encoded = BytesIO()
+    result.save(encoded, format="WEBP", quality=93, method=4, exact=False)
+    sys.stdout.write(PREFIX + base64.b64encode(encoded.getvalue()).decode("ascii"))
+
+
+if __name__ == "__main__":
+    main()
