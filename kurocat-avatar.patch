+export async function decodePortrait(source: PortraitSource): Promise<PortraitRig> {
+  const eyeLayers = Promise.all(source.eyes.map(async (eye) => {
+      const [fill, iris, blink] = await Promise.all([decode(eye.fill), decode(eye.iris), decode(eye.blink)]);
+      const outline = new Path2D();
+      outline.moveTo(...eye.outline[0]);
+      for (const vertex of eye.outline.slice(1)) outline.lineTo(...vertex);
+      outline.closePath();
+      return { outline, fill, iris, blink };
+    }));
+  if ('kind' in source) {
+    const [atlas, eyes] = await Promise.all([decode({x: 0, y: 0, src: source.atlas}), eyeLayers]);
+    const { width, height, states, waist, neck, faceEnd, collar } = source;
+    if (atlas.image.width !== width * states || atlas.image.height !== height * states) {
+      throw new Error('角色动作图尺寸不匹配');
+    }
+    const articulated = source.articulation;
+    const articulation = articulated ? {
+      torso: await decode(articulated.torso),
+      arms: await Promise.all(articulated.arms.map(async arm => ({
+        joints: arm.joints,
+        parts: await Promise.all(arm.parts.map(decode)),
+      }))),
+    } : undefined;
+    return { atlas: atlas.image, eyes, width, height, states, waist, neck, faceEnd, collar, articulation };
+  }
+  const [body, head, upper, forearm, hand, eyes] = await Promise.all([
+    decode(source.body), decode(source.head), decode(source.upper), decode(source.forearm),
+    decode(source.hand), eyeLayers,
+  ]);
+  // Older saved portraits stored two complementary pieces in the same photo coordinates.
+  let surface: Layer;
+  if (source.surface) {
+    surface = await decode(source.surface);
+  } else {
+    const canvas = document.createElement('canvas');
+    canvas.width = Math.max(body.x + body.image.width, head.x + head.image.width);
+    canvas.height = Math.max(body.y + body.image.height, head.y + head.image.height);
+    const ctx = canvas.getContext('2d')!;
+    paint(ctx, body);
+    paint(ctx, head);
+    surface = await decode({ x: 0, y: 0, src: canvas.toDataURL() });
+  }
+  return { surface, body, head, upper, forearm, hand, eyes };
+}
+
+function paint(ctx: CanvasRenderingContext2D, layer: Layer, x = 0, y = 0): void {
+  ctx.drawImage(layer.image, layer.x + x, layer.y + y);
+}
+
+function toWorld(pose: PortraitPose, point: Point): Point {
+  return {
+    x: pose.anchor.x + (point.x - HIP.x) * SCALE,
+    y: pose.anchor.y + (point.y - HIP.y) * SCALE,
+  };
+}
+
+function drawBone(
+  ctx: CanvasRenderingContext2D, layer: Layer, start: Point, end: Point,
+  from: Point, to: Point, mirror: boolean, thickness = SCALE,
+): void {
+  const sourceAngle = angle(start, end);
+  const targetAngle = angle(from, to);
+  const length = Math.max(0.21, distance(from, to) / distance(start, end));
+  ctx.save();
+  ctx.translate(from.x, from.y);
+  ctx.rotate(targetAngle);
+  ctx.scale(length, mirror ? -thickness : thickness);
+  ctx.rotate(-sourceAngle);
+  ctx.translate(-start.x, -start.y);
+  paint(ctx, layer);
+  ctx.restore();
+}
+
+function drawHand(
+  ctx: CanvasRenderingContext2D, layer: Layer, at: Point, direction: number, mirror: boolean,
+): void {
+  ctx.save();
+  ctx.translate(at.x, at.y);
+  ctx.rotate(direction);
+  ctx.scale(SCALE, mirror ? -SCALE : SCALE);
+  ctx.rotate(-angle(ELBOW, WRIST));
+  ctx.translate(-WRIST.x, -WRIST.y);
+  paint(ctx, layer);
+  ctx.restore();
+}
+
+function drawArm(ctx: CanvasRenderingContext2D, rig: PhotoRig, pose: PortraitPose, mirror: boolean): void {
+  const amount = Math.max(0, Math.min(1, mirror ? pose.rightReach : pose.leftReach));
+  if (mirror && amount < 0.07) return;
+  const shoulder = toWorld(pose, mirror ? FAR_SHOULDER : SHOULDER);
+  const rest = toWorld(pose, WRIST);
+  const elbowRest = toWorld(pose, ELBOW);
+  const relaxed = mirror ? { x: shoulder.x + 18, y: shoulder.y + 98 } : rest;
+  const target = mirror ? pose.right : pose.left;
+  const wrist = { x: mix(relaxed.x, target.x, amount), y: mix(relaxed.y, target.y, amount) };
+  const span = Math.max(1, distance(shoulder,wrist));
+  const upperLength = distance(SHOULDER,ELBOW) * SCALE;
+  const lowerLength = distance(ELBOW,WRIST) * SCALE;
+  const stretch = Math.max(1, (span + 1.6) / (upperLength + lowerLength));
+  const upper = upperLength * stretch;
+  const lower = lowerLength * stretch;
+  const projected = (upper * upper - lower * lower + span * span) / (2 * span);
+  const bend = Math.sqrt(Math.max(0,upper * upper - projected * projected)) * (mirror ? 1 : -1);
+  const nx = (wrist.x - shoulder.x) / span;
+  const ny = (wrist.y - shoulder.y) / span;
+  const joint = { x: shoulder.x + nx * projected - ny * bend, y: shoulder.y + ny * projected + nx * bend };
+  const elbow = mirror ? joint : { x: mix(elbowRest.x,joint.x,amount), y: mix(elbowRest.y,joint.y,amount) };
+
+  ctx.save();
+  if (mirror) ctx.globalAlpha = Math.min(1,amount * 3.5);
+  drawBone(ctx,rig.upper,SHOULDER,ELBOW,shoulder,elbow,mirror);
+  drawBone(ctx,rig.forearm,ELBOW,WRIST,elbow,wrist,mirror);
+  drawHand(ctx,rig.hand,wrist,angle(elbow,wrist),mirror);
+  ctx.restore();
+}
+
+export function drawPortraitBody(ctx: CanvasRenderingContext2D, rig: PortraitRig, pose: PortraitPose): void {
+  const anime = 'atlas' in rig ? rig : null;
+  if ('surface' in rig) drawArm(ctx,rig,pose,true);
+  const scale = anime ? 228 / anime.waist : SCALE;
+  const origin = anime
+    ? { x: pose.anchor.x - anime.width * scale / 2, y: pose.anchor.y - anime.waist * scale }
+    : toWorld(pose, { x: 0, y: 0 });
+  const neck = anime ? { x: anime.neck[0], y: anime.neck[1] } : NECK;
+  const frame = (press: number) => Math.round(Math.min(1, Math.max(0, press)) * ((anime?.states ?? 1) - 1));
+  const frameX = frame(pose.leftPress);
+  const frameY = frame(pose.rightPress);
+  ctx.save();
+  ctx.translate(origin.x, origin.y);
+  ctx.scale(scale, scale);
+  const base = ctx.getTransform();
+  const rotation = Math.max(-0.065, Math.min(0.065, pose.tilt * 0.42 + pose.turn * 0.004));
+  const nod = Math.max(-1.5, Math.min(1.5, pose.headOffset.y * 0.24));
+  const turn = Math.max(-2, Math.min(2, pose.turn * 0.16));
+
+  function followHead(weight: number): void {
+    ctx.setTransform(base);
+    ctx.translate(neck.x + turn * weight, neck.y + nod * weight);
+    ctx.rotate(rotation * weight);
+    ctx.translate(-neck.x, -neck.y);
+  }
+
+  // Clip in integer device pixels. Every output row samples the same photograph
+  // exactly once, including along the jaw, through the neck and at the collar.
+  const faceEnd = Math.round(base.f + base.d * (anime?.faceEnd ?? 154));
+  const collar = Math.max(faceEnd + 1, Math.round(base.f + base.d * (anime?.collar ?? 252)));
+  function band(top: number, bottom: number, weight: number): void {
+    top = Math.max(0, top);
+    bottom = Math.min(ctx.canvas.height, bottom);
+    if (top >= bottom) return;
+    ctx.save();
+    ctx.resetTransform();
+    ctx.beginPath();
+    ctx.rect(0, top, ctx.canvas.width, bottom - top);
+    ctx.clip();
+    followHead(weight);
+    if ('surface' in rig) {
+      paint(ctx, rig.surface);
+    } else if (rig.articulation) {
+      paint(ctx, rig.articulation.torso);
+    } else {
+      ctx.drawImage(rig.atlas, frameX * rig.width, frameY * rig.height, rig.width, rig.height,
+        0, 0, rig.width, rig.height);
+    }
+    ctx.restore();
+  }
+  band(0, faceEnd, 1);
+  for (let row = Math.max(0, faceEnd); row < Math.min(collar, ctx.canvas.height); row++) {
+    const t = (collar - row - 0.5) / (collar - faceEnd);
+    band(row, row + 1, t * t * (3 - 2 * t));
+  }
+  band(collar, ctx.canvas.height, 0);
+  followHead(1);
+  for (const eye of rig.eyes) {
+    if (pose.closed < 0.87 && Math.hypot(pose.gaze.x,pose.gaze.y) > 0.12) {
+      ctx.save();
+      ctx.clip(eye.outline);
+      ctx.globalAlpha = Math.min(1,Math.hypot(pose.gaze.x,pose.gaze.y) * 2.6);
+      paint(ctx,eye.fill);
+      paint(ctx,eye.iris,pose.gaze.x * 3.2,pose.gaze.y * 1.75);
+      ctx.restore();
+    }
+    if (pose.closed > 0.12) {
+      ctx.save();
+      ctx.globalAlpha = Math.min(1,(pose.closed - 0.12) / 0.72);
+      paint(ctx,eye.blink);
+      ctx.restore();
+    }
+  }
+  ctx.restore();
+}
+
+function drawIllustratedArm(ctx: CanvasRenderingContext2D, rig: AnimeRig, pose: PortraitPose,
+  arm: BoundArm<Layer>, side: number): void {
+  const scale = 228 / rig.waist;
+  const world = (p: Point): Point => ({
+    x: pose.anchor.x + (p.x - rig.width / 2) * scale,
+    y: pose.anchor.y + (p.y - rig.waist) * scale,
+  });
+  const blend = (p: Point, q: Point, t: number): Point => ({ x: mix(p.x, q.x, t), y: mix(p.y, q.y, t) });
+  const [s, e, w, tip] = arm.joints;
+  const shoulder = world(s);
+  const press = Math.min(1, side ? pose.rightPress : pose.leftPress);
+  const hover = !side && pose.mouseHand ? 0.74 + 0.26 * press : 1;
+  const reach = hover * Math.max(0, Math.min(1, side ? pose.rightReach : pose.leftReach));
+  const at = side ? pose.right : pose.left;
+  const contact = { x: at.x, y: at.y + 8 - (1 - press) * 18 };
+  const direction = side ? 1.20 : 1.84;
+  const handLength = distance(w, tip) * scale;
+  const wrist = {
+    x: contact.x - Math.cos(direction) * handLength,
+    y: contact.y - Math.sin(direction) * handLength,
+  };
+  const span = Math.max(1, distance(shoulder, wrist));
+  // Foreshortened artwork still needs two segments when the arm opens out.
+  const upper = Math.max(42, distance(s, e) * scale);
+  const lower = Math.max(42, distance(e, w) * scale);
+  const stretch = Math.max(1, (span + 4) / (upper + lower));
+  const along = Math.min(span, Math.max(0, (span * span + stretch * stretch * (upper * upper - lower * lower)) / (2 * span)));
+  const bend = (side ? -1 : 1) * Math.sqrt(Math.max(0, (upper * stretch) ** 2 - along ** 2));
+  const dx = (wrist.x - shoulder.x) / span;
+  const dy = (wrist.y - shoulder.y) / span;
+  const elbow = { x: shoulder.x + dx * along - dy * bend, y: shoulder.y + dy * along + dx * bend };
+  const targets = [shoulder, blend(world(e), elbow, reach), blend(world(w), wrist, reach)];
+  // Rotate the hand as one rigid piece when a folded arm changes direction.
+  const startAngle = angle(w, tip);
+  const delta = Math.atan2(Math.sin(direction - startAngle), Math.cos(direction - startAngle));
+  const handAngle = startAngle + reach * delta;
+  targets.push({ x: targets[2].x + handLength * Math.cos(handAngle), y: targets[2].y + handLength * Math.sin(handAngle) });
+  for (let i = 0; i < 3; i++) {
+    drawBone(ctx, arm.parts[i], arm.joints[i], arm.joints[i+1], targets[i], targets[i+1], false, scale);
+  }
+}
+
+export function drawPortraitForeground(ctx: CanvasRenderingContext2D, rig: PortraitRig, pose: PortraitPose): void {
+  if ('atlas' in rig) {
+    rig.articulation?.arms.forEach((arm, side) => drawIllustratedArm(ctx, rig, pose, arm, side));
+    return;
+  }
+  drawArm(ctx,rig,pose,false);
+  // The far arm is visible in front of the keyboard once it leaves its shoulder occlusion.
+  if (pose.rightReach > 0.15) {
+    ctx.save();
+    ctx.beginPath();
+    ctx.rect(0,pose.anchor.y - 7,pose.anchor.x * 2 + 180,112);
+    ctx.clip();
+    drawArm(ctx,rig,pose,true);
+    ctx.restore();
+  }
+}
