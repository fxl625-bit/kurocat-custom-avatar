@@ -0,0 +1,41 @@
+* { box-sizing: border-box; }
+:root {
+  color-scheme: light;
+  font-family: "Microsoft YaHei UI", "Segoe UI", system-ui, sans-serif;
+  background: #fbfaf7;
+  color: #232720;
+}
+body { margin: 0; }
+main { max-width: 560px; padding: 24px; margin: 0 auto; }
+h1 { font-size: 25px; margin: 0 0 8px; }
+p { font-size: 13px; line-height: 1.7; color: #565d51; margin: 0 0 14px; }
+h2 { margin: 0 0 7px; font-size: 15px; }
+.motion-section { padding-bottom: 14px; margin: 12px 0; border-bottom: 1px solid #dedfd6; }
+.motion-section button[aria-pressed="true"] { background: #315a42; border-color: #315a42; color: white; }
+.preview {
+  height: clamp(142px, 36vh, 240px);
+  display: grid;
+  place-items: center;
+  padding: 12px;
+  border: 1px solid #d7ddd0;
+  border-radius: 14px;
+  background: repeating-conic-gradient(#f0f1eb 0% 25%, #fafbf6 0% 50%) 0 0 / 22px 22px;
+}
+.preview img { width: 100%; height: 100%; min-height: 0; object-fit: contain; }
+.preview span { font-size: 13px; color: #565d51; }
+.actions { display: flex; flex-wrap: wrap; gap: 7px; margin: 14px 0 10px; }
+button {
+  appearance: none;
+  font: inherit;
+  font-size: 13px;
+  padding: 8px 11px;
+  border: 1px solid #ccd4c7;
+  color: inherit;
+  background: #fff;
+  border-radius: 8px;
+  cursor: pointer;
+}
+button.primary { background: #315a42; border-color: #315a42; color: white; }
+button:disabled { opacity: .5; cursor: default; }
+button:focus-visible { outline: 2px solid #356040; outline-offset: 2px; }
+#status { min-height: 22px; margin: 0; }
diff --git a/src/avatarMain.ts b/src/avatarMain.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fc2bdfd7d56084a05f777d92daca2e43534b5278
--- /dev/null
+++ b/src/avatarMain.ts
@@ -0,0 +1,200 @@
+import { invoke } from '@tauri-apps/api/core';
+import './avatar.css';
+
+
+const animeNames = { luffy: '路飞', nami: '娜美', naruto: '鸣人' } as const;
+type AnimeId = keyof typeof animeNames;
+interface Avatar {
+  image: string | null;
+  enabled: boolean;
+  character?: 'photographed-portrait' | AnimeId | null;
+}
+
+const input = document.querySelector<HTMLInputElement>('#image-file')!;
+const preview = document.querySelector<HTMLImageElement>('#preview-image')!;
+const placeholder = document.querySelector<HTMLElement>('#placeholder')!;
+const status = document.querySelector<HTMLElement>('#status')!;
+const choose = document.querySelector<HTMLButtonElement>('#choose')!;
+const cutout = document.querySelector<HTMLButtonElement>('#cutout')!;
+const apply = document.querySelector<HTMLButtonElement>('#apply')!;
+const restore = document.querySelector<HTMLButtonElement>('#restore')!;
+const motionSection = document.querySelector<HTMLElement>('#motion-section')!;
+const motion = document.querySelector<HTMLButtonElement>('#portrait-motion')!;
+motion.addEventListener('click', () => {
+  if (!busy) void save({ ...saved, enabled: false, character: 'photographed-portrait' });
+});
+
+const animeButtons = new Map<AnimeId, HTMLButtonElement>();
+void invoke<AnimeId[]>('available_anime').then((ids) => {
+  for (const id of ids) {
+    const button = document.createElement('button');
+    button.textContent = animeNames[id];
+    button.type = 'button';
+    button.dataset.character = id;
+    button.addEventListener('click', () => { if (!busy) void save({ ...saved, enabled: false, character: id }); });
+    document.querySelector('#anime-characters')!.append(button);
+    animeButtons.set(id, button);
+  }
+  document.querySelector<HTMLElement>('#anime-section')!.hidden = !ids.length;
+  refresh();
+}).catch(() => {});
+
+function characterName(id: NonNullable<Avatar['character']>): string {
+  return id === 'photographed-portrait' ? '动态人像' : animeNames[id];
+}
+
+let saved: Avatar = { image: null, enabled: false };
+let selected: string | null = null;
+let busy = true;
+
+function refresh(): void {
+  const image = selected ?? saved.image;
+  if (image) {
+    if (preview.getAttribute('src') !== image) preview.src = image;
+  } else {
+    preview.removeAttribute('src');
+  }
+  preview.hidden = !image;
+  placeholder.hidden = Boolean(image);
+  choose.disabled = busy;
+  cutout.disabled = busy || !image;
+  apply.disabled = busy || !image;
+  restore.disabled = busy || (!saved.enabled && !saved.character);
+  for (const [id, button] of animeButtons) {
+    button.disabled = busy;
+    button.setAttribute('aria-pressed', String(saved.character === id));
+  }
+  motion.disabled = busy;
+  motion.setAttribute('aria-pressed', String(saved.character === 'photographed-portrait'));
+  motion.textContent = saved.character === 'photographed-portrait' ? '正在使用动态人像' : '使用动态人像';
+}
+
+async function prepareImage(file: File): Promise<{ image: string; transparent: boolean }> {
+  if (file.size > 24 * 1024 * 1024) throw new Error('请选择 24 MB 以内的图片。');
+  if (file.type && !['image/png', 'image/jpeg', 'image/webp'].includes(file.type)) {
+    throw new Error('请选择 PNG、JPG 或 WebP 图片。');
+  }
+
+  const image = new Image();
+  const url = URL.createObjectURL(file);
+  try {
+    image.src = url;
+    await image.decode();
+    const ratio = Math.min(1, 768 / Math.max(image.naturalWidth, image.naturalHeight));
+    const canvas = document.createElement('canvas');
+    canvas.width = Math.max(1, Math.round(image.naturalWidth * ratio));
+    canvas.height = Math.max(1, Math.round(image.naturalHeight * ratio));
+    const ctx = canvas.getContext('2d')!;
+    ctx.drawImage(image, 0, 0, canvas.width, canvas.height);
+
+    // Trim blank margins so a transparent cutout sits directly above the keyboard.
+    const { data } = ctx.getImageData(0, 0, canvas.width, canvas.height);
+    let left = canvas.width, top = canvas.height, right = -1, bottom = -1;
+    let clearPixels = 0;
+    for (let y = 0; y < canvas.height; y++) {
+      for (let x = 0; x < canvas.width; x++) {
+        if (data[(y * canvas.width + x) * 4 + 3] <= 8) {
+          clearPixels++;
+          continue;
+        }
+        left = Math.min(left, x);
+        right = Math.max(right, x);
+        top = Math.min(top, y);
+        bottom = Math.max(bottom, y);
+      }
+    }
+    if (right < left) throw new Error('这张图片完全透明，请换一张。');
+    const cropped = document.createElement('canvas');
+    cropped.width = right - left + 1;
+    cropped.height = bottom - top + 1;
+    cropped.getContext('2d')!.drawImage(canvas, -left, -top);
+    const originalPixels = canvas.width * canvas.height;
+    const trimmedPixels = originalPixels - cropped.width * cropped.height;
+    return {
+      image: cropped.toDataURL('image/webp', 0.93),
+      transparent: clearPixels - trimmedPixels > cropped.width * cropped.height * 0.02,
+    };
+  } finally {
+    URL.revokeObjectURL(url);
+  }
+}
+
+async function removeBackground(image: string): Promise<string> {
+  status.textContent = '正在本机抠图…';
+  return invoke<string>('cutout_avatar', { image });
+}
+
+cutout.addEventListener('click', async () => {
+  const image = selected ?? saved.image;
+  if (!image || busy) return;
+  busy = true;
+  refresh();
+  try {
+    selected = await removeBackground(image);
+    status.textContent = '背景已去除，可应用到桌面。';
+  } catch (error) {
+    status.textContent = String(error);
+  } finally {
+    busy = false;
+    refresh();
+  }
+});
+
+choose.addEventListener('click', () => input.click());
+input.addEventListener('change', async () => {
+  const file = input.files?.[0];
+  input.value = '';
+  if (!file || busy) return;
+  busy = true;
+  refresh();
+  try {
+    const imported = await prepareImage(file);
+    selected = imported.transparent ? imported.image : await removeBackground(imported.image);
+    status.textContent = imported.transparent
+      ? '已保留透明背景，可应用到桌面。'
+      : '背景已去除，可应用到桌面。';
+  } catch (error) {
+    status.textContent = error instanceof DOMException
+      ? '无法读取图片，请换一张 PNG、JPG 或 WebP。'
+      : String(error).replace(/^Error: /, '');
+  } finally {
+    busy = false;
+    refresh();
+  }
+});
+
+async function save(avatar: Avatar): Promise<void> {
+  busy = true;
+  refresh();
+  try {
+    await invoke('save_avatar', { avatar });
+    saved = avatar;
+    selected = null;
+    status.textContent = avatar.character ? '已应用' + characterName(avatar.character) + '。'
+      : avatar.enabled ? '已应用到桌面。' : '已切回内置形象。';
+  } catch (error) {
+    status.textContent = '保存失败。' + String(error);
+  } finally {
+    busy = false;
+    refresh();
+  }
+}
+
+apply.addEventListener('click', () => {
+  const image = selected ?? saved.image;
+  if (image && !busy) void save({ image, enabled: true });
+});
+restore.addEventListener('click', () => {
+  if (!busy) void save({ ...saved, enabled: false, character: null });
+});
+
+refresh();
+void invoke<boolean>('has_portrait_rig').then((available) => { motionSection.hidden = !available; }).catch(() => {});
+void invoke<Avatar>('get_avatar')
+  .then((avatar) => {
+    saved = avatar;
+    status.textContent = avatar.character ? '当前使用' + characterName(avatar.character) + '。'
+      : avatar.enabled ? '当前使用照片形象。' : '当前使用内置形象。';
+  })
+  .catch(() => { status.textContent = '读取已保存的形象失败，可以重新选择图片。'; })
+  .finally(() => { busy = false; refresh(); });
